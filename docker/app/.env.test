# What `demo test` runs under (APP_ENV=test): .env, then this file - never
# .env.local, which Symfony skips in the test environment. Test values only:
# the kernel the suites boot, and every variable the bundles' configuration
# reads, so that no suite dies on a missing one before its first test.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
# A fresh SQLite file per run (demo.sh creates its schema).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
DEFAULT_URI=http://localhost
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
# Google's public reCAPTCHA test keys: every answer passes.
GOOGLE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
MAILER_DSN=null://null
MAILER_CONTACT=contact@example.org
MESSENGER_TRANSPORT_DSN=sync://
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
