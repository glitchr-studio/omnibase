{#
 # The host application's page chrome: the only contract the plugins'
 # templates have with their host is this file's `content`, `aside`, `title`,
 # `stylesheets` and `javascripts` blocks. A real site puts its header, menu
 # and footer here.
 #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Demo{% endblock %} — glitchr/omnibase</title>
    <style>
        body { margin: 0; background: #eef2f5; font: 14px/1.5 system-ui, sans-serif; color: #284555; }
        .demo-bar { background: #006699; color: #fff; padding: .5rem 1rem; font-size: 13px; }
        .demo-bar a { color: #fff; }
        .demo-cols { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 1.5rem; max-width: 1100px; margin: 1.5rem auto; padding: 0 1rem; }
        @media (max-width: 860px) { .demo-cols { grid-template-columns: 1fr; } }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="demo-bar">
        glitchr/omnibase demo — signed in as <b>{{ app.user ? app.user.username : 'nobody' }}</b> ·
        <a href="{{ path('demo_index') }}">tour</a> ·
        <a href="/boutiques">shop</a> · <a href="/bbs">forum</a> · <a href="/messagerie">mailbox</a> ·
        <a href="/support">support</a> · <a href="/compte/licences">licences</a> · <a href="/git">git</a> · <a href="/admin">admin</a>
    </div>
    <div class="demo-cols">
        <main>{% block content %}{% endblock %}</main>
        <aside>{% block aside %}{% endblock %}</aside>
    </div>
    {% block javascripts %}{% endblock %}
</body>
</html>
