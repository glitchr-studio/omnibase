{# layout3, not layout1: layout1's collapsible sidebar-nav toggler
   (__menu__() in index.js) reads/writes the "app/menu/toggle" localStorage
   key on every hard page load, and error responses are always hard loads
   (never the AJAX soft-nav that normally skips this). That forced the
   sidebar open on every error regardless of the visitor's actual saved
   preference. layout3 pages are exempt: __menu__() bails out immediately
   because it gates on #page's data-layout being "layout1" - same pattern
   already used by maintenance.html.twig/launchdate.html.twig for other
   full-screen, nav-less pages.

   A site that has no layout3 (the sites scaffolded from Apfelschule have
   layout1 alone) is given its layout1: without a layout to extend, this page
   could not be rendered at all, and every unknown address answered 500 in
   place of 404 wherever debug is off (prod, demo). #}
{% extends ['layout3.html.twig', 'layout1.html.twig'] %}

{% block navbar %}{% endblock %}
{% block flashbag %}{% endblock %}
{% block sidebar %}{% endblock %}

{% block content %}
    <div class="exception half text-center wrapper">
        {% set knownExceptionTitle = ("@controllers.exception." ~ flattenException.statusCode ~ ".title")|trans %}
        {% set knownExceptionMessage = ("@controllers.exception." ~ flattenException.statusCode ~ ".message")|trans %}

        {% set knownException = knownExceptionTitle != flattenException.statusCode %}
        {% if  knownException %}

            <h1 class="exception-title">{{ flattenException.statusCode }} {{ knownExceptionTitle }}</h1>
            <p>{{ knownExceptionMessage ?? ('@controllers.exception.message'|trans) }}</p>
        {% else %}
            {% set code = ((flattenException.statusCode != 0) ? flattenException.statusCode : null)|default(500) %}
            {% set technicalSupport = setting_bag.mail._self|default(app.bag("base.notifier.technical_support")) %}
            <h1 class="exception-title">{{ code }} {{"@controllers.exception.unknown"|trans}}</h1>
            <h3>{{ '@controllers.exception.title'|trans }}</h3>
            <p class="exception-message">{{ '@controllers.exception.message'|trans([technicalSupport])|raw }}</p>
        {% endif %}

        {% set referer = app.request.server.get('http-referer')|default(asset('')) %}
        <p class="exception-referer">{{ '@controllers.exception.return'|trans([referer])|raw }}<p>
    </div>
{% endblock %}
