{% extends 'layout1.html.twig' %}

{#- optional = the offer made once after a sign-in from an unknown browser
    (NewDeviceSubscriber), on an account with no second factor; otherwise
    the administrator's mandatory enrolment. Same choices, other words. -#}
{% set _optional = optional|default(false) %}
{% set _title = (_optional ? '@forms.settings.newDevicePromptTitle' : '@forms.settings.enrolmentTitle')|trans %}
{% block title %}{{ _title }}{% endblock %}
{% block content %}
<article class="wrapper extended">
<h1>{{ _title }}</h1>

<div class="card mb-3">
    <div class="card-header"><i class="fa-fw fa-solid fa-shield-halved"></i> {{'@forms.settings.twoFactor'|trans}}</div>
    <div class="card-body">
        <p>{{ (_optional ? '@forms.settings.newDevicePromptIntro' : '@forms.settings.enrolmentIntro')|trans }}</p>

        <ul class="list-group mb-3">
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                    <strong>{{'@forms.settings.totpApp'|trans}}</strong>
                    <br><small class="text-muted">{{'@forms.settings.totpAppHelp'|trans}}</small>
                </span>
                <a class="btn btn-sm btn-primary" href="{{ path('user_settings_2fa') }}">{{'@forms.settings.enable'|trans}}</a>
            </li>
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                    <strong>{{'@forms.settings.emailCode'|trans}}</strong>
                    <br><small class="text-muted">{{'@forms.settings.emailCodeHelp'|trans}}</small>
                </span>
                <form class="mb-0" method="post" action="{{ path('user_settings_2fa_email_toggle') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('2fa_email') }}">
                    <button class="btn btn-sm btn-outline-primary" type="submit">{{'@forms.settings.enable'|trans}}</button>
                </form>
            </li>
            {% if policy.arePasskeysAvailable() %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                    <strong>{{'@forms.settings.passkeys'|trans}}</strong>
                    <br><small class="text-muted">{{'@forms.settings.passkeyHelp'|trans}}</small>
                </span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-passkey-register="{{ user.getUserIdentifier() }}">
                    <i class="fa-fw fa-solid fa-passport"></i> {{'@forms.settings.addPasskey'|trans}}
                </button>
            </li>
            {% endif %}
        </ul>

        {# The way out. It exists so a policy change cannot strand somebody
           mid-task; while enrolment is mandatory the answer is kept in the
           session only, and this page comes back on the next sign-in. Not
           offered where the application allows no "later"
           (base.security.two_factor.postpone: false). #}
        {% if skippable ?? true %}
        <form method="post" action="{{ path('user_settings_enrolment_skip') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('2fa_enrolment_skip') }}">
            <button class="btn btn-sm btn-link text-muted" type="submit">{{ (_optional ? '@forms.settings.newDevicePromptSkip' : '@forms.settings.enrolmentSkip')|trans }}</button>
        </form>
        {% endif %}
    </div>
</div>

</article>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Base/security/_passkey_messages.html.twig' %}
    {{ encore_entry_script_tags('webauthn') }}
{% endblock %}
