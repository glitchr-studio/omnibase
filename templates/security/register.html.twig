{% extends 'layout1.html.twig' %}

{% block title %}Register{% endblock %}

{% block stylesheets %}
<style>
.invalid-feedback {
    display: block;
}
.invalid-feedback ul li {
    list-style: none;
}


.invalid-feedback ul li:before {
    content: "\f1e2"; /* FontAwesome Unicode */
    font-size: 15pt;
    font-weight: 900;
    font-family: "Font Awesome 6 Free";

    display: inline-block;
    width: 1.2em;
    margin-left: 1em;

    position: relative;
    top: 2px;
    left: 0px;
}
</style>
{% endblock %}

{% block content %}
<article class="half signin d-flex justify-content-center">
    {{ form_start(form) }}
    <div class="card">
        <div class="card-header">
            <h3 class="text-center">Sign Up</h3>
            {# Google only, as on the login page: it is the one provider whose
               oauth_* route redirects anywhere (the others are bare paths). #}
            {% if oauth_available('google') %}
            <div class="d-flex justify-content-center social-icons">
                <a href="{{path("oauth_google")}}" class="btn btn-lg btn-social-icon-circle btn-outline-google-alt"></a>
            </div>
            {% endif %}
        </div>

        <div class="card-body">

            {#- What is wrong with the sign-up as a whole, and belongs to no field: an address somebody
                already signed up with (the account's uniqueness is checked on the entity, its violation
                is the form's own). It was never printed: the form came back as typed, without a word. -#}
            {{ include('@Base/security/_field_feedback.html.twig', {field: form}) }}

            {#- That address has an account: the two ways in. (A sign-up that succeeds signs in at once,
                so this page cannot keep it secret; the forgotten-password page does - it answers the
                same for every address.) -#}
            {% if account_exists|default(false) %}
            <p class="signup-account-exists text-center mb-2">
                <a href="{{ path('security_login') }}">{{ '@forms.register.signIn'|trans }}</a>
                &middot;
                <a href="{{ path('security_resetPassword') }}">{{ '@forms.register.forgotPassword'|trans }}</a>
            </p>
            {% endif %}

            <div class="input-group form-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa-fw fa-solid fa-at {{ form.email.vars.required ? "required" : "" }}"></i>
                    </span>
                </div>
                {{ form_widget(form.email, {'attr': {'placeholder': '@forms.register.email'|trans}}) }}

            </div>
            {{ include('@Base/security/_field_feedback.html.twig', {field: form.email}) }}

            <div class="input-group form-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa-fw fa-solid fa-lock-open  {{ form.plainPassword.first.vars.required ? "required" : "" }}"></i></span>
                </div>
                {{ form_widget(form.plainPassword.first, {'attr': {'placeholder': '@forms.register.password'|trans}}) }}
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa-fw fa-solid fa-lock {{ form.plainPassword.second.vars.required ? "required" : "" }}"></i></span>
                </div>
                {{ form_widget(form.plainPassword.second, {'attr': {'placeholder': '@forms.register.passwordConfirm'|trans}}) }}
            </div>
            {{ include('@Base/security/_field_feedback.html.twig', {field: form.plainPassword.first}) }}

            <hr>

            <div class="col d-flex justify-content-center">
                <div class="form-group form-check form-switch form-switch-md">
                    {{ form_widget(form.agreeTerms) }}
                    {#- The terms/privacy page: base.settings.legal_page (a page slug,
                        set on the site's settings page), else "gdpr". -#}
                    {% set _legal = app.settingBag.getScalar('base.settings.legal_page') ?: 'gdpr' %}
                    {{ form_label(form.agreeTerms, '@forms.register.agreeTerms'|trans([path("widget_page", {"slug": _legal})])) }}
                </div>
            </div>
            <div class="col d-flex justify-content-center">
                {{ form_rest(form) }}
            </div>
        </div>

        <div class="card-footer">
            <div class="col d-flex justify-content-end">
                <button class="btn btn-lg btn-primary btn-block" type="submit">{{ '@forms.register.submit'|trans }}</button>&nbsp;&nbsp;
                <button class="btn btn-lg btn-outline-primary btn-block" type="reset">{{'@forms.register.reset'|trans }}</button>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
</article>
{% endblock %}
