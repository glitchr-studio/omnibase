{% extends 'layout1.html.twig' %}

{# Also the first password of an account made for someone (security_changePassword): its own `heading`, `description`. #}
{% block title %}{{ (heading ?? '@forms.resetPassword.title')|trans }}{% endblock %}

{% block content %}
<article class="wrapper">
<div class="card">
    <div class="card-header">
        <h3 class="text-center">{{ (heading ?? '@forms.resetPassword.title')|trans }}</h3>
    </div>
    <div class="card-body" >
        {{ form_start(form) }}

        <p>{{ (description ?? '@forms.resetPassword.description')|trans }}</p><hr>
        <div class="input-group form-group mb-2">
            <div class="input-group-prepend">
                <span class="input-group-text"><i class="fa-fw fa-solid fa-lock-open  {{ form.plainPassword.first.vars.required ? "required" : "" }}"></i></span>
            </div>
            {{ form_widget(form.plainPassword.first, {'attr': {'placeholder': '@forms.resetPassword.newPassword'|trans}}) }}
            <div class="input-group-prepend">
                <span class="input-group-text"><i class="fa-fw fa-solid fa-lock {{ form.plainPassword.second.vars.required ? "required" : "" }}"></i></span>
            </div>
            {{ form_widget(form.plainPassword.second, {'attr': {'placeholder': '@forms.resetPassword.newPasswordConfirm'|trans}}) }}
        </div>
        {{ include('@Base/security/_field_feedback.html.twig', {field: form.plainPassword.first}) }}
        
        <div class="col d-flex justify-content-center">
            <button class="btn btn-lg btn-primary" type="submit">{{ '@forms.resetPassword.submit'|trans }}</button>
        </div>
        {{ form_end(form) }}
    </div>
</article>
{% endblock %}

