{#
 # omnibase's e-mail frame. A notification renders it with its own context; a
 # plain TemplatedEmail may extend it as well, giving nothing but its blocks:
 #
 #     {% extends '@Base/notifier/email.html.twig' %}
 #     {% block subject %}Your appointment{% endblock %}
 #     {% block content %}<p>...</p>{% endblock %}
 #
 # Every variable has a default (it used to stop on "Variable importance does
 # not exist"), the subject is the `subject` variable or the `subject` block,
 # and the logo is printed only when there is one: the `logo` variable, else
 # the back office's setting (base.settings.logo.email, then base.settings.logo).
 #}
{%- set importance = importance ?? null -%}
{%- set markdown = markdown ?? false -%}
{%- set raw = raw ?? false -%}
{%- set content = content ?? '' -%}
{%- set action_url = action_url ?? null -%}
{%- set action_text = action_text ?? action_url -%}
{%- set exception = exception ?? false -%}
{%- if (subject is not defined or subject is empty) and block('subject') is defined -%}
    {%- set subject = block('subject')|striptags|trim -%}
{%- endif -%}
{%- set subject = subject ?? '' -%}
{%- set logo = logo ?? app.email.logo ?? null -%}
{% apply inky_to_html|inline_css %}
<html>
<head>
<title>
    {% block title %}
        {{ subject|default('@messages.slogan')|trans }}
    {% endblock %}
</title>
<link rel="stylesheet" href="https://assets.glitchr.io/fonts/stylesheet.css">

<style>

    {% block style %}
        {{ source("@Base/notifier/main.css") }}
        {{ source("@Base/notifier/local.css") }}
    {% endblock %}
</style>
</head>
<body>
<spacer size="32"></spacer>
<wrapper class="body">
    <container class="body_{{ ("urgent" == importance ? "alert" : ("high" == importance ? "warning" : "default")) }}">
        <spacer size="16"></spacer>
        {% block header %}
            {% if logo is not empty %}
            <row>
                <columns large="12" small="12" class="header logo">
                    <img src="{{ embed(logo) }}" alt="{{ app.email.title ?? '' }}" style="max-height: 64px; width: auto;">
                </columns>
            </row>
            {% endif %}
        {% endblock %}
        <row>
            <columns large="12" small="12">
                {% block lead %}
                    {% if importance is not null %}<small><strong>{{ importance|upper }}</strong></small>{% endif %}
                    <p class="lead">
                        {{ subject }}
                    </p>
                {% endblock %}

                {% block content %}
                    {% if markdown %}
                        {{ include('@Base/notifier/content_markdown.html.twig') }}
                    {% else %}
                        {{ (raw ? content|raw : content)|nl2br }}
                    {% endif %}
                {% endblock %}

                {% block action %}
                    {% if action_url %}
                        <spacer size="16"></spacer>
                        <button href="{{ action_url }}">{{ action_text }}</button>
                    {% endif %}
                {% endblock %}

                {% block exception %}
                    {% if exception %}
                        <spacer size="16"></spacer>
                        <p><em>Exception stack trace attached.</em></p>
                    {% endif %}
                {% endblock %}
            </columns>
        </row>

        <wrapper class="secondary">
            <spacer size="16"></spacer>
            {% block footer %}
                {% if footer_text is defined and footer_text is not null %}
                <row>
                    <columns small="12" large="6">
                        {% block footer_content %}
                            <p><small>{{ footer_text }}</small></p>
                        {% endblock %}
                    </columns>
                </row>
                {% endif %}
            {% endblock %}
        </wrapper>
    </container>
</wrapper>
</body>
</html>
{% endapply %}
