{#
 # Glitch Art's signature, the same on every site: the year on two lines beside
 # the pixel monkey (it dances on hover), in Source Code Pro bold 18pt/21px,
 # linking to https://www.glitchr.io - LaToucheOriginale's credits_glitchr macro.
 # Its stylesheet: bundles/base/css/credits.css (linked here).
 #
 #   {% include '@Base/partials/_credits.html.twig' with {color: 'white', outline: true} %}
 #
 # Parameters - nothing else is customisable, neither the font nor a site colour:
 #   color    'black' (default) or 'white': the text and the monkey; grey on hover
 #   outline  true: a white contour around the text and the monkey, for a photo or a busy background
 #   mirror   true: the detail line on the right of the signature instead of the left
 #   rule     true: a dotted rule between the detail's two lines
 #   detail   false: no detail line at all
 #   site_name the detail's second line (none by default)
 #
 # The detail line beside it (the address, the time the page took, and the
 # site's name) is hidden until the signature is pointed at or focused, always
 # shown without a pointer (@media (hover: none)). An app fills it with embed:
 #
 #   {% embed '@Base/partials/_credits.html.twig' %}
 #       {% block credits_detail %}{{ parent() }}<span class="ga-credits-line" lang="de">Ein Apfel am Tag</span>{% endblock %}
 #   {% endembed %}
 #}
{%- set year = 'now'|date('Y') -%}
{%- set color = (color|default('black')) == 'white' ? 'white' : 'black' -%}
<link rel="stylesheet" href="{{ asset('bundles/base/css/credits.css') }}">
<div class="ga-credits ga-credits--{{ color }}{{ outline|default(false) ? ' ga-credits--outline' }}{{ mirror|default(false) ? ' ga-credits--mirror' }}{{ rule|default(false) ? ' ga-credits--rule' }}">
    {%- if detail|default(true) %}
    <p class="ga-credits-detail">
        {%- block credits_detail -%}
        <span class="ga-credits-line">{{ app.request.httpHost|default('')|upper }} <span class="ga-credits-time">[{{ app.site.execution_time|default(0)|number_format(2) }}s]</span></span>
        {%- if site_name|default(null) %}<span class="ga-credits-line">{{ site_name }}</span>{% endif -%}
        {%- endblock -%}
    </p>
    {%- endif %}
    <a class="ga-credits-sign" href="https://www.glitchr.io" target="_blank" rel="noopener" aria-label="{{ year }} Glitch Art">
        <span class="ga-credits-year" aria-hidden="true"><span>{{ year|slice(0, 2) }}</span><span>{{ year|slice(2, 2) }}</span></span>
<svg class="ga-credits-monkey" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320">
