{
    "name": "glitchr/omnibase",
    "type": "symfony-bundle",
    "description": "Base helper integration for Symfony",
    "keywords": [
        "symfony",
        "base",
        "helper"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibase",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\": "./src"
        },
        "files": [
            "src/Resources/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\": "./tests"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omniguard.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omniguard-akismet.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omniguard-altcha.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omniguard-disposable.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omnisign.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omnisign-docuseal.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-exif": "*",
        "ext-igbinary": "*",
        "ext-imagick": "*",
        "beberlei/doctrineextensions": "^1.0",
        "doctrine/doctrine-bundle": "^2.0|^3.0",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/symfony": "^4.0",
        "doctrine/orm": "^2.15|^3.0",
        "symfony/asset": "^6.0|^7.0|^8.0",
        "symfony/expression-language": "^6.0|^7.0|^8.0",
        "embed/embed": "^4.4",
        "endroid/qr-code": "^6.0",
        "enshrined/svg-sanitize": "^0.22",
        "florianv/swap": "^4.0",
        "glitchr/backup-manager": "4.0.*-dev",
        "glitchr/well-known": "1.0.*-dev",
        "glitchr/base-plugin": "2.0.*-dev",
        "glitchr/doctrine-dc2type": "1.0.*-dev",
        "glitchr/ux-google": "1.0.*-dev",
        "hashids/hashids": "^5.0",
        "jaybizzle/crawler-detect": "^1.2",
        "hwi/oauth-bundle": "^2.1",
        "imagine/imagine": "^1.2",
        "league/flysystem-bundle": "^3.1",
        "league/flysystem-ftp": "^3.0",
        "nelmio/cors-bundle": "^2.2",
        "nelmio/security-bundle": "^3.0",
        "phpoffice/phpspreadsheet": "^1.23|^2.0",
        "picqer/php-barcode-generator": "^2.0",
        "scheb/2fa": "^7.0|^8.0",
        "scienta/doctrine-json-functions": "~4.3",
        "web-auth/webauthn-symfony-bundle": "^5.3",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/discord-notifier": "^6.0|^7.0|^8.0",
        "symfony/dotenv": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/intl": "^6.0|^7.0|^8.0",
        "symfony/mailer": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0",
        "symfony/monolog-bundle": "^3.8|^4.0",
        "symfony/notifier": "^6.0|^7.0|^8.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/serializer": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0",
        "symfony/uid": "^6.0|^7.0|^8.0",
        "symfony/validator": "^6.0|^7.0|^8.0",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/workflow": "^6.0|^7.0|^8.0",
        "twig/cache-extra": "^3.0",
        "twig/cssinliner-extra": "^3.0",
        "twig/extra-bundle": "^3.0",
        "twig/inky-extra": "^3.0",
        "twig/intl-extra": "^3.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "doctrine/doctrine-fixtures-bundle": "demo:reset reloads the fixtures (the demo environment)",
        "dompdf/dompdf": "Base\\Response\\PdfResponse: an HTML page answered as a PDF (^3.0)",
        "symfony/lock": "demo:reset runs under a lock (the demo environment)",
        "glitchr/omniguard": "Base\\Service\\FormGuard's captcha, address lists and content classifier (the option `guard` of a form, Akismet behind SpamChecker): register Omniguard\\Bridge\\Symfony\\OmniguardBundle; not on Packagist yet - a vcs repository, https://github.com/glitchr-studio/omniguard",
        "omniguard/altcha": "ALTCHA, the default captcha of FormGuard: a proof of work served and checked by the site, no third party, no cookie, no consent",
        "omniguard/akismet": "Akismet behind Base\\Service\\SpamChecker (base.guard.classifier)",
        "omniguard/disposable": "Disposable e-mail domains refused at sign-up (base.guard.reputation)",
        "glitchr/omnisign": "Base\\Service\\Signatures: documents signed for any entity (Base\\Entity\\Signature\\Envelope, mapped only with it), the signed file and its evidence kept in the private storage; register Omnisign\\Bridge\\Symfony\\OmnisignBundle; not on Packagist yet - a vcs repository, https://github.com/glitchr-studio/omnisign",
        "omnisign/docuseal": "A DocuSeal instance of one's own: nothing leaves for a third party (omnisign/yousign, omnisign/docusign for the providers)"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "wapmorgan/php-deprecation-detector": "^2.0",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "squizlabs/php_codesniffer": "^3.7",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "symfony/debug-bundle": "^6.0|^7.0|^8.0",
        "symfony/lock": "^6.0|^7.0|^8.0",
        "symfony/phpunit-bridge": "^6.0|^7.0|^8.0",
        "symfony/stopwatch": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0",
        "symfony/web-profiler-bundle": "^6.0|^7.0|^8.0",
        "glitchr/omniguard": "1.x-dev",
        "omniguard/akismet": "1.x-dev",
        "omniguard/altcha": "1.x-dev",
        "omniguard/disposable": "1.x-dev",
        "glitchr/omnisign": "1.x-dev",
        "omnisign/docuseal": "1.x-dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "glitchr/base-plugin": true,
            "glitchr/doctrine-dc2type": true,
            "endroid/installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    }
}
